# ------------------------------
# Logging
# ------------------------------
API_LOG_LEVEL=info
DBINIT_LOG_LEVEL=info

# ------------------------------
# OpenTelemetry (disabled by default)
# ------------------------------
# OTEL_TRACES_EXPORTER:
#   console (default) - spans logged to stdout as JSON; no sidecars needed.
#   otlp              - spans sent to the collector -> Jaeger (UI :16686).
#                       `make reboot-docker-heavy` brings up the collector +
#                       Jaeger and overrides the API to otlp, so you do NOT set
#                       this to otlp here for the heavy stack.
#   none              - tracing disabled.
# OTEL_EXPORTER_OTLP_ENDPOINT: collector address on the compose network. For a
#   host `make api-dev` against the heavy stack, use http://localhost:4317.
# OTEL_SAMPLE_RATIO: root-trace sampling ratio (1.0 = capture everything).
OTEL_ENABLED=false
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SAMPLE_RATIO=1.0

# ------------------------------
# API
# ------------------------------
ENVIRONMENT=development

# ------------------------------
# Auth (Auth0)
# ------------------------------
# The template ships with auth DISABLED so `make dev` works out of the box.
# When you are ready to wire up Auth0, set AUTH_DISABLED=false and fill in
# your tenant/audience values below.
AUTH_DISABLED=true
# AUTH_ISSUER="https://YOUR_TENANT.auth0.com/"
# AUTH_AUDIENCE="https://your-api-identifier"
# AUTH_JWKS_URI="https://YOUR_TENANT.auth0.com/.well-known/jwks.json"

# ------------------------------
# Database connection (API runtime user)
# ------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app_user
POSTGRES_PASSWORD=SuperSecureApp1!

# ------------------------------
# Database bootstrap / roles
# ------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
APP_USER_PASSWORD=SuperSecureApp1!
APP_MIGRATOR_PASSWORD=SuperSecureMigrator1!
DB_SCHEMA_MODE=if-empty

# ------------------------------
# Frontend
# ------------------------------
# Runtime config (Auth0 tenant, API URL, appEnv, etc.) is loaded from
# deployments/frontend/public/config.json at boot. Preview/prod deployments
# write that file at deploy time; the local dev config is checked in.
# Only compile-time frontend flags belong here.
